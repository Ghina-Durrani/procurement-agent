APP_ENV=development

# Used by Docker to create the database
POSTGRES_USER=procurement_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=procurement_db

# Filled in from Sprint 2 onward
DATABASE_URL=

# LLM provider (default: Groq free tier). Never paste a real key into chat or into code.
# To switch provider, change the three values below; no code change is needed.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Development only (D-058): the seeded demo user every API call acts as, until login exists.
# Create it once with: python -m app.services.intake.seed_demo (run from backend/)
DEMO_USER_EMAIL=demo.employee@example.test

# Which AI reads requests submitted in the app (D-059): fake (no tokens, default) or live (Groq).
EXTRACTION_MODE=fake

# Browser origins allowed to call the API (JSON list). The Vite dev server by default.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
