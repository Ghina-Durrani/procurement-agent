APP_ENV=development

# Used by Docker to create the database
POSTGRES_USER=procurement_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=procurement_db

# Filled in from Sprint 2 onward
DATABASE_URL=

# LLM provider (default: Groq free tier). Never paste a real key into chat or into code.
# To switch provider, change the three values below; no code change is needed.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b